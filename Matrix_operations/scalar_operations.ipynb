#single value
#we can apply operations with a scalar,a single value to entire array
#operations
array=np.array([1,2,3])
print(array+1)   #[2 3 4]
print(array-2)   #[-1  0  1]
print(array//2)  #[0 1 1]
print(array/4)   #[0.25 0.5  0.75]
print(array*3)   #[3 6 9]
print(array*3+1) #[ 4  7 10]
print(array**2)  #[1 4 9]
